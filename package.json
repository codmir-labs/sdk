{
  "name": "@codmir/sdk",
  "version": "2.0.1",
  "description": "Official Codmir SDK - TypeScript/JavaScript library for the Codmir API",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "require": "./dist/client.cjs",
      "import": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "require": "./dist/types.cjs",
      "import": "./dist/types.js"
    },
    "./overseer": {
      "types": "./dist/overseer/index.d.ts",
      "require": "./dist/overseer/index.cjs",
      "import": "./dist/overseer/index.js"
    },
    "./tracing": {
      "types": "./dist/tracing/index.d.ts",
      "require": "./dist/tracing/index.cjs",
      "import": "./dist/tracing/index.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs/index.d.ts",
      "require": "./dist/nextjs/index.cjs",
      "import": "./dist/nextjs/index.js"
    },
    "./nextjs/server": {
      "types": "./dist/nextjs/server.d.ts",
      "require": "./dist/nextjs/server.cjs",
      "import": "./dist/nextjs/server.js"
    },
    "./react-native": {
      "types": "./dist/react-native/index.d.ts",
      "require": "./dist/react-native/index.cjs",
      "import": "./dist/react-native/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "require": "./dist/browser/index.cjs",
      "import": "./dist/browser/index.js"
    },
    "./replay": {
      "types": "./dist/replay/index.d.ts",
      "require": "./dist/replay/index.cjs",
      "import": "./dist/replay/index.js"
    },
    "./serverless": {
      "types": "./dist/serverless/index.d.ts",
      "require": "./dist/serverless/index.cjs",
      "import": "./dist/serverless/index.js"
    },
    "./council": {
      "types": "./dist/council/index.d.ts",
      "require": "./dist/council/index.cjs",
      "import": "./dist/council/index.js"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "require": "./dist/runtime/index.cjs",
      "import": "./dist/runtime/index.js"
    },
    "./runtime/protocol": {
      "types": "./src/runtime/protocol/index.ts",
      "require": "./dist/runtime/protocol/index.cjs",
      "import": "./dist/runtime/protocol/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "require": "./dist/agent/index.cjs",
      "import": "./dist/agent/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "require": "./dist/mcp/index.cjs",
      "import": "./dist/mcp/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "require": "./dist/express/index.cjs",
      "import": "./dist/express/index.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "require": "./dist/hono/index.cjs",
      "import": "./dist/hono/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "require": "./dist/ai/index.cjs",
      "import": "./dist/ai/index.js"
    },
    "./remix": {
      "types": "./dist/remix/index.d.ts",
      "require": "./dist/remix/index.cjs",
      "import": "./dist/remix/index.js"
    },
    "./remix/server": {
      "types": "./dist/remix/server.d.ts",
      "require": "./dist/remix/server.cjs",
      "import": "./dist/remix/server.js"
    },
    "./verify": {
      "types": "./dist/verify/index.d.ts",
      "require": "./dist/verify/index.cjs",
      "import": "./dist/verify/index.js"
    },
    "./report": {
      "types": "./dist/report/index.d.ts",
      "require": "./dist/report/index.cjs",
      "import": "./dist/report/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/client.ts src/types.ts src/framework.ts src/overseer/index.ts src/tracing/index.ts src/nextjs/index.ts src/nextjs/server.ts src/react-native/index.ts src/browser/index.ts src/replay/index.ts src/serverless/index.ts src/council/index.ts src/runtime/index.ts src/runtime/protocol/index.ts src/agent/index.ts src/mcp/index.ts src/express/index.ts src/hono/index.ts src/ai/index.ts src/remix/index.ts src/remix/server.ts src/verify/index.ts src/report/index.ts --format cjs,esm --clean",
    "dev": "tsup src/index.ts src/client.ts src/types.ts src/framework.ts src/overseer/index.ts src/tracing/index.ts src/nextjs/index.ts src/nextjs/server.ts src/react-native/index.ts src/browser/index.ts src/replay/index.ts src/serverless/index.ts src/council/index.ts src/runtime/index.ts src/runtime/protocol/index.ts src/agent/index.ts src/mcp/index.ts src/express/index.ts src/hono/index.ts src/ai/index.ts src/remix/index.ts src/remix/server.ts src/verify/index.ts src/report/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "codmir",
    "sdk",
    "api",
    "client",
    "typescript",
    "ai",
    "serverless",
    "cloud",
    "functions",
    "sandbox",
    "modal-alternative",
    "project-management",
    "tickets",
    "tasks"
  ],
  "author": "Codmir <hello@codmir.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/codmir-labs/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/codmir-labs/sdk/issues"
  },
  "homepage": "https://codmir.com/docs/sdk",
  "sideEffects": [
    "dist/chunk-*.js",
    "dist/chunk-*.cjs"
  ],
  "dependencies": {
    "nanoid": "^5.0.9",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@prisma/client": "6.19.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "^20.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "jsdom": "^24.1.3",
    "hono": "^4.13.16",
    "next-auth": "4.24.15",
    "semantic-release": "^24.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "8.72.1",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  }
}
