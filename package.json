{
  "name": "@codmir/sdk",
  "version": "2.2.0",
  "description": "Codmir SDK: error tracking, tracing and session replay, plus the Codmir API client",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./overseer": {
      "import": {
        "types": "./dist/overseer/index.d.ts",
        "default": "./dist/overseer/index.js"
      },
      "require": {
        "types": "./dist/overseer/index.d.cts",
        "default": "./dist/overseer/index.cjs"
      }
    },
    "./tracing": {
      "import": {
        "types": "./dist/tracing/index.d.ts",
        "default": "./dist/tracing/index.js"
      },
      "require": {
        "types": "./dist/tracing/index.d.cts",
        "default": "./dist/tracing/index.cjs"
      }
    },
    "./nextjs": {
      "import": {
        "types": "./dist/nextjs/index.d.ts",
        "default": "./dist/nextjs/index.js"
      },
      "require": {
        "types": "./dist/nextjs/index.d.cts",
        "default": "./dist/nextjs/index.cjs"
      }
    },
    "./nextjs/server": {
      "import": {
        "types": "./dist/nextjs/server.d.ts",
        "default": "./dist/nextjs/server.js"
      },
      "require": {
        "types": "./dist/nextjs/server.d.cts",
        "default": "./dist/nextjs/server.cjs"
      }
    },
    "./react-native": {
      "import": {
        "types": "./dist/react-native/index.d.ts",
        "default": "./dist/react-native/index.js"
      },
      "require": {
        "types": "./dist/react-native/index.d.cts",
        "default": "./dist/react-native/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "require": {
        "types": "./dist/browser/index.d.cts",
        "default": "./dist/browser/index.cjs"
      }
    },
    "./replay": {
      "import": {
        "types": "./dist/replay/index.d.ts",
        "default": "./dist/replay/index.js"
      },
      "require": {
        "types": "./dist/replay/index.d.cts",
        "default": "./dist/replay/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express/index.d.ts",
        "default": "./dist/express/index.js"
      },
      "require": {
        "types": "./dist/express/index.d.cts",
        "default": "./dist/express/index.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono/index.d.ts",
        "default": "./dist/hono/index.js"
      },
      "require": {
        "types": "./dist/hono/index.d.cts",
        "default": "./dist/hono/index.cjs"
      }
    },
    "./remix": {
      "import": {
        "types": "./dist/remix/index.d.ts",
        "default": "./dist/remix/index.js"
      },
      "require": {
        "types": "./dist/remix/index.d.cts",
        "default": "./dist/remix/index.cjs"
      }
    },
    "./remix/server": {
      "import": {
        "types": "./dist/remix/server.d.ts",
        "default": "./dist/remix/server.js"
      },
      "require": {
        "types": "./dist/remix/server.d.cts",
        "default": "./dist/remix/server.cjs"
      }
    },
    "./verify": {
      "import": {
        "types": "./dist/verify/index.d.ts",
        "default": "./dist/verify/index.js"
      },
      "require": {
        "types": "./dist/verify/index.d.cts",
        "default": "./dist/verify/index.cjs"
      }
    },
    "./report": {
      "import": {
        "types": "./dist/report/index.d.ts",
        "default": "./dist/report/index.js"
      },
      "require": {
        "types": "./dist/report/index.d.cts",
        "default": "./dist/report/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/client.ts src/types.ts src/overseer/index.ts src/tracing/index.ts src/nextjs/index.ts src/nextjs/server.ts src/react-native/index.ts src/browser/index.ts src/replay/index.ts src/express/index.ts src/hono/index.ts src/remix/index.ts src/remix/server.ts src/verify/index.ts src/report/index.ts --format cjs,esm --clean --dts",
    "dev": "tsup src/index.ts src/client.ts src/types.ts src/overseer/index.ts src/tracing/index.ts src/nextjs/index.ts src/nextjs/server.ts src/react-native/index.ts src/browser/index.ts src/replay/index.ts src/express/index.ts src/hono/index.ts src/remix/index.ts src/remix/server.ts src/verify/index.ts src/report/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test:agent-kit": "npm test --workspace @codmir/agent-kit",
    "check:dist": "node scripts/check-dist-types.mjs"
  },
  "keywords": [
    "codmir",
    "sdk",
    "api",
    "client",
    "typescript",
    "ai",
    "project-management",
    "tickets",
    "tasks",
    "error-tracking",
    "tracing",
    "session-replay"
  ],
  "author": "Codmir <hello@codmir.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/codmir-labs/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/codmir-labs/sdk/issues"
  },
  "homepage": "https://codmir.com/docs/sdk",
  "sideEffects": [
    "dist/chunk-*.js",
    "dist/chunk-*.cjs"
  ],
  "dependencies": {
    "@rrweb/record": "2.2.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@prisma/client": "6.19.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.4",
    "@types/express": "5.0.6",
    "@types/node": "^20.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.27.0",
    "eslint": "9.39.5",
    "jsdom": "^24.1.3",
    "hono": "^4.13.16",
    "next-auth": "4.24.15",
    "semantic-release": "^24.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "8.72.1",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "overrides": {
    "@semantic-release/github": "$@semantic-release/github"
  },
  "workspaces": [
    "packages/*"
  ]
}
